# Copy this file to `.env` and fill in your secrets. Never commit `.env`.
# PostgreSQL (recommended):
DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5000/distract_yt
# OR zero-setup SQLite (no Postgres needed) — uncomment and use this instead:
# DATABASE_URL=sqlite:///distract_yt.db
YOUTUBE_API_KEY=
HOST=127.0.0.1
PORT=8000
DEBUG=1
CACHE_TTL_SECONDS=86400
CHANNEL_IMPORT_LIMIT=15